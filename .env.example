# ==========================================
# Application Version
# ==========================================
APP_VERSION=latest

# ==========================================
# Telegram Bot Configuration
# ==========================================
BOT_TOKEN=your_telegram_bot_token
CHAT_ID=your_telegram_admin_chat_id

# ==========================================
# Domain & SSL Settings
# ==========================================
DOMAIN=yourdomain.com
CERTBOT_EMAIL=admin@yourdomain.com

# ==========================================
# Database Configuration
# ==========================================
DB_NAME=botpanel
DB_USER=botpanel_user
DB_PASS=strong_db_password
MYSQL_ROOT_PASSWORD=strong_root_password

# ==========================================
# Backup & Telegram Scheduled Backup Configuration
# ==========================================
# Optional: defaults to BOT_TOKEN and CHAT_ID if left empty
BACKUP_TELEGRAM_TOKEN=your_telegram_bot_token
BACKUP_CHAT_ID=your_telegram_admin_chat_id
BACKUP_RETENTION_DAYS=1
# Optional: fixed interval in minutes between backups. Unset/empty keeps midnight (Asia/Tehran) schedule. Min 5.
# BACKUP_INTERVAL_MINUTES=60
# Optional: total backup attempts per run, default 3. Min 1.
# BACKUP_MAX_RETRIES=3

# ==========================================
# Logging Configuration (env wins over bot_config.json)
# ==========================================
# LOG_LEVEL=WARNING
# LOG_BUFFER_SIZE=1000
# LOG_RETENTION_DAYS=30
# LOG_DIR=
# LOG_TELEGRAM_ENABLED=true
# LOG_TELEGRAM_MIN_LEVEL=ERROR
# LOG_TELEGRAM_DEDUP_SECONDS=3600
# LOG_TELEGRAM_DEDUP_ENABLED=true